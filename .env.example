# Copy to .env and configure the main generation model only.
TRAJ_LTLF_LLM_MODE=api
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_name_here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_THINKING_MODE=default
LLM_RESPONSE_FORMAT_MODE=auto

# Optional local diagnostics; disabled by default.
TRAJ_LTLF_NLU_DEBUG=0
TRAJ_LTLF_NLU_DEBUG_DIR=data/output/debug/nlu
